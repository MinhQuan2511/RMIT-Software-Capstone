# Copy to backend/.env and adjust. All values are optional; defaults are local-only.
# Never put secrets here that must reach the browser.

# HTTP port and bind address. Keep loopback: this service writes files and can start
# a desktop application. Non-loopback binding is refused unless VD_ALLOW_NON_LOOPBACK=1.
PORT=5000
VD_BIND_HOST=127.0.0.1
# VD_ALLOW_NON_LOOPBACK=1

# Frontend origins allowed to call the API (comma-separated).
VD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local job store (projects, sources, jobs, revisions). Default: backend/data
# VD_DATA_DIR=D:\\VertexDynamics\\data

# Watched folder. WATCH_FOLDER seeds the initial value (relative to the repository root).
# Folders must lie inside an approved root. Built-in roots: samples/ (demo) and watch-inbox/.
# Extra roots, separated by ; on Windows or : elsewhere:
# VD_WATCH_ROOTS=D:\\Scans\\TracerStudioExports
WATCH_FOLDER=samples
# Settle interval before a file is ingested (milliseconds).
VD_WATCH_SETTLE_MS=2000
# VD_CONFIG_PATH=backend/config.json

# Where "Save" writes generated modules. Default: the user's Downloads folder.
# VD_EXPORT_DIR=C:\\Users\\you\\Downloads

# Trusted override for the RobotStudio executable (absolute path ending in RobotStudio.exe).
# Default discovery scans Program Files\\ABB\\RobotStudio*\\Bin.
# VD_ROBOTSTUDIO_EXE=C:\\Program Files (x86)\\ABB\\RobotStudio 2026\\Bin\\RobotStudio.exe
